# Copiá este archivo como .env.local si necesitás cambiar algo. Solo las variables
# con prefijo VITE_ llegan al navegador: nunca pongas secretos acá.

# Base de la API. Dejala en /api: en desarrollo Vite hace proxy al server
# y en producción Vercel hace rewrite a Railway (mismo origen → cookies sin problemas).
VITE_API_URL=/api

# Solo para desarrollo: a dónde redirige el proxy de Vite.
API_PROXY_TARGET=http://localhost:4000
