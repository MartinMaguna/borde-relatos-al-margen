# Copiá este archivo como .env y completá los valores. Nunca subas .env al repo.

# Entorno: development | production | test
NODE_ENV=development
# Railway inyecta PORT automáticamente en producción
PORT=4000

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/borde?retryWrites=true&w=majority

# Secreto para firmar los JWT (mínimo 32 caracteres). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
# Duración de la sesión del editor, en horas
SESSION_TTL_HOURS=8
# Intentos de login permitidos por IP cada 15 minutos
LOGIN_RATE_LIMIT=10

# Origen del cliente en desarrollo (CORS). En producción el cliente llega same-origin vía rewrite de Vercel.
CLIENT_ORIGIN=http://localhost:5173

# Usuario editor que crea `npm run seed`
SEED_EDITOR_NAME=Editora Borde
SEED_EDITOR_EMAIL=editora@example.com
# Mínimo 12 caracteres
SEED_EDITOR_PASSWORD=una-contrasena-larga-y-segura
